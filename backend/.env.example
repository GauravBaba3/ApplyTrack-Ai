# Django Configuration
DJANGO_SECRET_KEY=
DEBUG=True

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=

# Backblaze B2 Cloud Object Storage Configuration (S3-Compatible)
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=applytrack-ai-emails
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# AI Pipeline Provider Keys & Configurable Models (Strict cascade: Rule Engine -> HF -> Groq -> Gemini -> OpenRouter -> Human Review)
HF_TOKEN=your-huggingface-api-token
HF_MODEL_NAME=facebook/bart-large-mnli
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_PROVIDER_TIMEOUT_SECONDS=15

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# Gmail Ingestion Batch Size & Retention (Configurable defaults: 25 batch size, 90 days retention)
GMAIL_SYNC_PAGE_SIZE=25
GMAIL_SYNC_INITIAL_DAYS=90
RAW_EMAIL_RETENTION_DAYS=90

# Worker, Queue & Concurrency Configuration
QUEUE_BATCH_SIZE=25
MAX_CONCURRENT_WORKERS=1
WORKER_LOCK_TIMEOUT_SECONDS=600
MAX_JOB_RETRIES=3
BASE_RETRY_BACKOFF_SECONDS=30

# Server Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5174
